{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM"],
    "outDir": "dist/js",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*"]
}
