{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ES2020", "DOM"],
    "outDir": "dist/js",
    "rootDir": "src/ts",
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*", "config/**/*"]
}
