{
    "name": "avpvh/find-and-view",
    "description": "Find and view photos, archaeological finds, and scanned documents stored in Google Drive",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "grmt",
            "email": "info@example.invalid"
        }
    ],
    "autoload": {
        "psr-4": {
            "Avpvh\\FindAndView\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Avpvh\\FindAndView\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.2"
        }
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/promises": "^2.0",
        "monolog/monolog": "^3.0",
        "psr/cache": "^3.0",
        "psr/http-message": "^2.0",
        "woocommerce/action-scheduler": "^4.0",
        "meilisearch/meilisearch-php": "^1.16"
    },
    "suggest": {
        "google/apiclient": "Required for Google Drive storage backend (^2.15)",
        "google/apiclient-services": "Required for Google Drive storage backend (^0.358)",
        "aws/aws-sdk-php": "Required for S3 storage backend (^3.0)"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "humbug/php-scoper": "^0.18",
        "phan/phan": "^5.1",
        "phpmd/phpmd": "^2.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "skaut/wordpress-stubs": "^2.1",
        "slevomat/coding-standard": "^8.2",
        "squizlabs/php_codesniffer": "^3.0",
        "wp-coding-standards/wpcs": "^3.0"
    }
}
