{
    "name": "avpvh/find-and-view",
    "description": "Find and view photos, archaeological finds, and scanned documents stored in Google Drive",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "grmt",
            "email": "info@example.invalid"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "classmap-authoritative": true,
        "platform": {
            "php": "8.2"
        }
    },
    "require": {
        "php": "^8.2",
        "google/apiclient": "^2.15",
        "google/apiclient-services": "^0.358",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/promises": "^2.0",
        "monolog/monolog": "^3.0",
        "psr/cache": "^3.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "humbug/php-scoper": "^0.18",
        "phan/phan": "^5.1",
        "phpmd/phpmd": "^2.6",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "skaut/wordpress-stubs": "^2.1",
        "slevomat/coding-standard": "^8.2",
        "squizlabs/php_codesniffer": "^3.0",
        "wp-coding-standards/wpcs": "^3.0",
        "yoast/phpunit-polyfills": "^2.0"
    }
}
